import 'package:flutter/material.dart';
import 'services/user_service.dart';

class MedalItem {
  final String id;
  final String title;
  final String description;
  final String category;
  final IconData icon;
  final Color color;
  final bool isUnlocked;
  final String requirement;

  MedalItem({
    required this.id,
    required this.title,
    required this.description,
    required this.category,
    required this.icon,
    required this.color,
    required this.isUnlocked,
    required this.requirement,
  });
}

class MedalWallScreen extends StatefulWidget {
  const MedalWallScreen({super.key});

  @override
  State<MedalWallScreen> createState() => _MedalWallScreenState();
}

class _MedalWallScreenState extends State<MedalWallScreen> with SingleTickerProviderStateMixin {
  final UserService _userService = UserService();
  late TabController _tabController;
  String _equippedMedalId = 'm1';

  final List<String> _categories = ['All', 'Gifting', 'Host', 'Social', 'Events'];

  late List<MedalItem> _allMedals;

  @override
  void initState() {
    super.initState();
    _tabController = TabController(length: _categories.length, vsync: this);
    _initMedals();
  }

  @override
  void dispose() {
    _tabController.dispose();
    super.dispose();
  }

  void _initMedals() {
    _allMedals = [
      // Gifting
      MedalItem(
        id: 'm1',
        title: 'First Gifter',
        description: 'Sent the first gift in a voice room.',
        category: 'Gifting',
        icon: Icons.card_giftcard,
        color: Colors.amber,
        isUnlocked: true,
        requirement: 'Send any gift in any live voice room.',
      ),
      MedalItem(
        id: 'm2',
        title: 'Big Spender',
        description: 'Spent over 100,000 coins on gifts.',
        category: 'Gifting',
        icon: Icons.diamond,
        color: Colors.purpleAccent,
        isUnlocked: _userService.coins >= 100000,
        requirement: 'Send 100,000 coins worth of gifts.',
      ),
      MedalItem(
        id: 'm3',
        title: 'Lucky Striker',
        description: 'Hit a major multiplier on Lucky Gifts.',
        category: 'Gifting',
        icon: Icons.casino,
        color: Colors.orangeAccent,
        isUnlocked: true,
        requirement: 'Win a multiplier higher than 50x in Lucky Gifts.',
      ),

      // Host
      MedalItem(
        id: 'm4',
        title: 'Rising Star',
        description: 'Streamed for over 10 active hours.',
        category: 'Host',
        icon: Icons.mic,
        color: Colors.tealAccent,
        isUnlocked: true,
        requirement: 'Host voice rooms for more than 10 hours.',
      ),
      MedalItem(
        id: 'm5',
        title: 'Diamond Magnet',
        description: 'Collected over 500,000 diamonds.',
        category: 'Host',
        icon: Icons.workspace_premium,
        color: Colors.lightBlueAccent,
        isUnlocked: false,
        requirement: 'Accumulate 500,000 diamonds as a room host.',
      ),

      // Social
      MedalItem(
        id: 'm6',
        title: 'Super Ambassador',
        description: 'Successfully invited 10 active friends.',
        category: 'Social',
        icon: Icons.people,
        color: Colors.greenAccent,
        isUnlocked: true,
        requirement: 'Invite 10 users through your invitation code.',
      ),
      MedalItem(
        id: 'm7',
        title: 'Loyal Guardian',
        description: 'Active for 30 consecutive days.',
        category: 'Social',
        icon: Icons.verified_user,
        color: Colors.amberAccent,
        isUnlocked: false,
        requirement: 'Log into Nile Voice for 30 consecutive days.',
      ),

      // Events
      MedalItem(
        id: 'm8',
        title: 'Carnival Champion',
        description: 'Ranked top 3 in the weekly voice event.',
        category: 'Events',
        icon: Icons.emoji_events,
        color: Colors.pinkAccent,
        isUnlocked: false,
        requirement: 'Finish in the Top 3 leaderboard of any official event.',
      ),
    ];
  }

void _showMedalDetails(MedalItem medal) {
    final bool isEquipped = (_equippedMedalId == medal.id);

    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: const Color(0xFF161B26),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              padding: const EdgeInsets.all(18),
              decoration: BoxDecoration(
                color: medal.isUnlocked ? medal.color.withOpacity(0.15) : Colors.white10,
                shape: BoxShape.circle,
              ),
              child: Icon(
                medal.icon,
                size: 48,
                color: medal.isUnlocked ? medal.color : Colors.white30,
              ),
            ),
            const SizedBox(height: 16),
            Text(
              medal.title,
              style: const TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 8),
            Text(
              medal.description,
              textAlign: TextAlign.center,
              style: const TextStyle(color: Colors.white70, fontSize: 13),
            ),
            const SizedBox(height: 14),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
              decoration: BoxDecoration(
                color: const Color(0xFF0D111A),
                borderRadius: BorderRadius.circular(10),
                border: Border.all(color: Colors.white10),
              ),
              child: Text(
                'Requirement: ${medal.requirement}',
                textAlign: TextAlign.center,
                style: const TextStyle(color: Colors.white54, fontSize: 11),
              ),
            ),
          ],
        ),
        actionsAlignment: MainAxisAlignment.center,
        actions: [
          if (medal.isUnlocked)
            ElevatedButton(
              style: ElevatedButton.styleFrom(
                backgroundColor: isEquipped ? Colors.grey : const Color(0xFF00C9A7),
                shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 10),
              ),
              onPressed: () {
                setState(() {
                  _equippedMedalId = isEquipped ? '' : medal.id;
                });
                Navigator.pop(ctx);
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text(isEquipped ? 'Medal removed' : 'Equipped ${medal.title}!'),
                    backgroundColor: const Color(0xFF00C9A7),
                  ),
                );
              },
              child: Text(
                isEquipped ? 'Unequip' : 'Wear Medal',
                style: TextStyle(
                  color: isEquipped ? Colors.white : Colors.black,
                  fontWeight: FontWeight.bold,
                ),
              ),
            )
          else
            TextButton(
              onPressed: () => Navigator.pop(ctx),
              child: const Text('Close', style: TextStyle(color: Colors.white54)),
            ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final int unlockedCount = _allMedals.where((m) => m.isUnlocked).length;

    return Scaffold(
      backgroundColor: const Color(0xFF0F101A),
      appBar: AppBar(
        backgroundColor: const Color(0xFF161826),
        elevation: 0,
        centerTitle: true,
        leading: IconButton(
          icon: const Icon(Icons.arrow_back_ios_new, color: Colors.white, size: 20),
          onPressed: () => Navigator.pop(context),

),
        title: const Text(
          'Medal Wall',
          style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold, fontSize: 18),
        ),
        bottom: TabBar(
          controller: _tabController,
          isScrollable: true,
          indicatorColor: const Color(0xFF00C9A7),
          labelColor: const Color(0xFF00C9A7),
          unselectedLabelColor: Colors.white54,
          indicatorWeight: 3,
          tabs: _categories.map((c) => Tab(text: c)).toList(),
        ),
      ),
      body: Column(
        children: [
          // Banner Overview
          Container(
            margin: const EdgeInsets.all(16),
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              gradient: const LinearGradient(
                colors: [Color(0xFF2C1E57), Color(0xFF1A1A32)],
                begin: Alignment.topLeft,
                end: Alignment.bottomRight,
              ),
              borderRadius: BorderRadius.circular(16),
              border: Border.all(color: Colors.white10),
            ),
            child: Row(
              children: [
                const Icon(Icons.emoji_events, color: Colors.amberAccent, size: 40),
                const SizedBox(width: 14),
                Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    const Text(
                      'Honor & Achievements',
                      style: TextStyle(color: Colors.white, fontSize: 16, fontWeight: FontWeight.bold),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      'Unlocked: $unlockedCount / ${_allMedals.length} Medals',
                      style: const TextStyle(color: Colors.white70, fontSize: 13),
                    ),
                  ],
                ),
              ],
            ),
          ),

          // Medals Grid View
          Expanded(
            child: TabBarView(
              controller: _tabController,
              children: _categories.map((cat) {
                final list = cat == 'All'
                    ? _allMedals
                    : _allMedals.where((m) => m.category == cat).toList();

                return GridView.builder(
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                  itemCount: list.length,
                  gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 3,
                    crossAxisSpacing: 12,
                    mainAxisSpacing: 14,
                    childAspectRatio: 0.82,
                  ),
                  itemBuilder: (context, idx) {
                    final medal = list[idx];
                    final bool isEquipped = (_equippedMedalId == medal.id);

                    return GestureDetector(
                      onTap: () => _showMedalDetails(medal),
                      child: Container(
                        padding: const EdgeInsets.all(10),
                        decoration: BoxDecoration(
                          color: const Color(0xFF161826),
                          borderRadius: BorderRadius.circular(14),
                          border: Border.all(
                            color: isEquipped
                                ? const Color(0xFF00C9A7)
                                : (medal.isUnlocked ? medal.color.withOpacity(0.3) : Colors.white10),
                            width: isEquipped ? 2 : 1,
                          ),
                        ),
                        child: Column(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            Stack(
                              alignment: Alignment.center,

children: [
                                CircleAvatar(
                                  radius: 26,
                                  backgroundColor: medal.isUnlocked
                                      ? medal.color.withOpacity(0.15)
                                      : Colors.white10,
                                  child: Icon(
                                    medal.icon,
                                    size: 26,
                                    color: medal.isUnlocked ? medal.color : Colors.white24,
                                  ),
                                ),
                                if (!medal.isUnlocked)
                                  const Icon(Icons.lock, size: 16, color: Colors.white54),
                              ],
                            ),
                            const SizedBox(height: 8),
                            Text(
                              medal.title,
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                              textAlign: TextAlign.center,
                              style: TextStyle(
                                color: medal.isUnlocked ? Colors.white : Colors.white38,
                                fontWeight: FontWeight.bold,
                                fontSize: 12,
                              ),
                            ),
                            const SizedBox(height: 4),
                            Text(
                              isEquipped
                                  ? 'Active'
                                  : (medal.isUnlocked ? 'Unlocked' : 'Locked'),
                              style: TextStyle(
                                color: isEquipped
                                    ? const Color(0xFF00C9A7)
                                    : (medal.isUnlocked ? Colors.white54 : Colors.white24),
                                fontSize: 10,
                                fontWeight: isEquipped ? FontWeight.bold : FontWeight.normal,
                              ),
                            ),
                          ],
                        ),
                      ),
                    );
                  },
                );
              }).toList(),
            ),
          ),
        ],
      ),
    );
  }
}
